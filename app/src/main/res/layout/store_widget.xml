<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#17191E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="МАГАЗИН РЯДОМ"
            android:textColor="#D6B45A"
            android:textSize="10sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ОБНОВЛЯЕТСЯ"
            android:textColor="#A9B2BE"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_network"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Сеть не выбрана"
        android:textColor="#D6B45A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Выбери сеть в приложении"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/widget_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Адрес ближайшего филиала появится здесь"
        android:textColor="#B9BBC2"
        android:textSize="11sp"
        android:maxLines="2" />

    <ImageView
        android:id="@+id/widget_map"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="8dp"
        android:background="#292D34"
        android:scaleType="centerCrop"
        android:contentDescription="Карта: синяя точка — ты, красная — магазин, зелёная линия — маршрут" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Синяя точка — ты · золотая — магазин · зелёная линия — пешком"
        android:textColor="#9298A3"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Расстояние появится после поиска"
        android:textColor="#E7D39A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_eta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Пешее время появится после построения маршрута"
        android:textColor="#B9BBC2"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/widget_refresh"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Обновить"
            android:textAllCaps="false"
            android:textSize="11sp" />
        <Button
            android:id="@+id/widget_route"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="Маршрут"
            android:textAllCaps="false"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
